<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>个人名片</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <!-- 名片主体：集中展示个人基本信息与联系方式 -->
  <main class="business-card">
    <!-- 使用图片作为头像，加载失败时显示替代文字 -->
    <img
      class="avatar"
      src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=240&q=80"
      alt="林简的头像"
    >

    <!-- 个人身份信息 -->
    <section class="profile-info">
      <h1>林简</h1>
      <p class="role">前端开发工程师</p>
      <p class="bio">专注于创造清晰、友好的数字体验</p>
    </section>

    <!-- 联系方式列表 -->
    <address class="contact-list">
      <a href="mailto:linjian@example.com">
        <span class="contact-icon" aria-hidden="true">✉</span>
        <span>linjian@example.com</span>
      </a>
      <a href="tel:+8613800138000">
        <span class="contact-icon" aria-hidden="true">☎</span>
        <span>+86 138 0013 8000</span>
      </a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer">
        <span class="contact-icon" aria-hidden="true">⌘</span>
        <span>github.com/linjian</span>
      </a>
    </address>
  </main>
</body>
</html>
